    Proper configuration of this section can optimize your build process and streamline development workflows.
    -->
    <plugins>
        <plugin>
            <!-- Apache Maven that is used to compile the source code of a project. -->
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <version>3.10.1</version>
            <configuration>
                <source>${java.version}</source>
                <target>${java.version}</target>
                <encoding>UTF-8</encoding>
