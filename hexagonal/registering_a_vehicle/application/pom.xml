<profiles>
    <!--
    Section: profiles
    Using profiles to define properties
    -->
    <profile>
        <id>dev</id>
        <properties>
            <property name="database.url" value="jdbc:mysql://localhost:3306/devdb"/>
            <property name="database.username" value="devuser"/>
            <property name="database.password" value="devpassword"/>
        </properties>
    </profile>
    <profile>
        <id>prd</id>
        <properties>
            <property name="database.url" value="jdbc:mysql://prodhost:3306/prddb"/>
            <property name="database.username" value="prduser"/>
            <property name="database.password" value="prdpassword"/>
        </properties>
    </profile>
</profiles>
